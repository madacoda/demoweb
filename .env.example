# Run `node scripts/setup-env.mjs` to generate a local password and matching URL.
POSTGRES_USER=demo_district
POSTGRES_DB=demo_district
POSTGRES_PORT=5433
POSTGRES_PASSWORD=replace-with-a-local-random-password
DATABASE_URL=postgresql://demo_district:replace-with-a-local-random-password@127.0.0.1:5433/demo_district
